{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "infra: mysql redis kafka ollama",
      "type": "shell",
      "command": "docker compose -p virbius-infra -f docker-compose.infra.yml up -d --wait",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "compile: engine and control",
      "type": "shell",
      "command": "export JAVA_HOME=\"$( [ -d /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ] && echo /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home || /usr/libexec/java_home -v 17 )\"; export PATH=\"$JAVA_HOME/bin:$PATH\"; echo \"Using JAVA_HOME=$JAVA_HOME\"; mvn -pl virbius-engine,virbius-control -am compile -DskipTests",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$maven-java-compile-problem-matcher",
      "group": "build"
    },
    {
      "label": "prelaunch: infra and compile",
      "dependsOn": [
        "infra: mysql redis kafka ollama",
        "compile: engine and control"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "type": "shell",
      "command": "echo prelaunch ready"
    },
    {
      "label": "frontend: npm install",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/virbius-control/frontend"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "infra: down",
      "type": "shell",
      "command": "docker compose -p virbius-infra -f docker-compose.infra.yml down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
