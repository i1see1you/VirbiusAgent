{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "infra: mysql redis kafka ollama",
      "type": "shell",
      "command": "docker compose -p virbius-infra -f docker-compose.infra.yml up -d --wait",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "compile: engine and control",
      "type": "shell",
      "command": "export JAVA_HOME=\"$( [ -d /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ] && echo /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home || /usr/libexec/java_home -v 17 )\"; export PATH=\"$JAVA_HOME/bin:$PATH\"; echo \"Using JAVA_HOME=$JAVA_HOME\"; mvn -pl virbius-engine,virbius-control,virbius-auth -am compile -DskipTests",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "prelaunch: infra and compile",
      "dependsOn": [
        "infra: mysql redis kafka ollama",
        "compile: engine and control"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "type": "shell",
      "command": "echo prelaunch ready"
    },
    {
      "label": "demo: prepare",
      "type": "shell",
      "command": "set -e; if [ ! -x .venv/bin/python ]; then python3 -m venv .venv; fi; if ! .venv/bin/python -c 'import flask, mcp' >/dev/null 2>&1; then .venv/bin/pip install -q -r requirements.txt; fi; if [ ! -f .env ]; then cp .env.example .env; echo 'created .env from .env.example'; fi",
      "options": {
        "cwd": "${workspaceFolder}/virbius-demo"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "prelaunch: infra compile and demo",
      "dependsOn": [
        "prelaunch: infra and compile",
        "demo: prepare"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "type": "shell",
      "command": "echo prelaunch ready"
    },
    {
      "label": "frontend: npm install",
      "type": "shell",
      "command": "/opt/homebrew/bin/npm install",
      "options": {
        "cwd": "${workspaceFolder}/virbius-control/frontend"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "infra: down",
      "type": "shell",
      "command": "docker compose -p virbius-infra -f docker-compose.infra.yml down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
