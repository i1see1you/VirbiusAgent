# 复制本文件为 .env 并填入你的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Agent 危险命令是否在 Docker 容器内隔离执行（1=是，需先构建沙箱镜像）
AGENT_USE_DOCKER=0
# OpenRouter Key（接入国产+国外众多小模型，可选）
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
# 本地模型（Ollama）端点，可选；先 ollama pull deepseek-r1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- VirbiusAgent Agent 越权防护（Rust mcp-proxy 云端 Groovy 评估）----
# 链路：Agent(ReAct) -> Rust virbius-mcp-proxy(stdio) -> engine(/v1/evaluate)
#                                             -> upstream mcp_runtime FastMCP SSE（9091-9097）
#
# 一关一租户一张 License。启动 bootstrap 会写入 /data/config.json 的 licenses.{lab}，
# 也可在「基础设置」里按关卡级联覆盖。下面这张旧的并集票不再读取。
# VIRBIUS_LICENSE_JWT=
# 【回填】当前登录用户（越权基线：只允许访问该 userId）
VIRBIUS_SESSION_USER_ID=1
# CTF / 非 MCP 的 OWASP 仍走 default + demo-app（端侧 PyO3 / virbius_guard）
VIRBIUS_TENANT_ID=default
VIRBIUS_APP_ID=demo-app
# 【可选】Rust mcp-proxy 二进制路径；留空则自动查找 ../virbius-mcp-proxy/target/debug/
VIRBIUS_MCP_PROXY_BIN=
#
# 注意：engine 地址、license 公钥 PEM 文件路径、upstream(MCP SSE) 地址等写在
# virbius-mcp-proxy.toml（virbius-demo 目录下，Rust proxy 启动时读取）。见该文件【回填】标注。
