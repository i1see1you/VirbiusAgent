# Rust
target/

# Java/Maven
**/target/
*.class
*.jar
*.war

# IDE
.idea/
*.iml
.vscode/
*~

# Tool private config
.catpaw/

# macOS
.DS_Store

# Node.js
node_modules/

# Python
__pycache__/
*.pyc

# Generated
*.log
.env

# Runtime data (databases, logs, generated artifacts)
*.db
*.db-*
*.sqlite
*.sqlite3
*.jsonl
data/**/*.log
data/**

# virbius-demo: re-include its source data (offline manifest, labs, config).
# Runtime caches under data/edge/{control,cloud} are excluded again in
# virbius-demo/.gitignore.
!virbius-demo/data/
!virbius-demo/data/**

# Build artifacts
dependency-reduced-pom.xml

# Slow CI integration test scripts (excluded from shellcheck)
scripts/test-*.sh

# Backup files
*.bak

# Local Helm values with secrets (never commit)
deploy/helm/virbius/values-prod.yaml
deploy/helm/virbius/values-*.local.yaml

# PPT
ppt/
