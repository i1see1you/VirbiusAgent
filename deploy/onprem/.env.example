# ─────────────────────────────────────────────────────────────────────────────
# VirbiusAgent 客户现场三机部署 · 环境变量样例（复制为 .env 后填写；勿提交真实值）
# 适用：deploy/onprem/node-*.yml。MySQL/Kafka/Redis/vLLM 由客户统一环境提供。
# ─────────────────────────────────────────────────────────────────────────────

# ── 客户统一环境 ──────────────────────────────────────────────────────────────
MYSQL_USER=virbius
MYSQL_PASSWORD=__change_me__
# 库必须先建为 utf8mb4（否则 control/auth 启动时直接拒绝，不会跑迁移）：
#   CREATE DATABASE virbius CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# control/auth 共用的完整 JDBC URL（MariaDB 驱动；按客户 MySQL 的 TLS 策略改）：
VIRBIUS_JDBC_URL=jdbc:mariadb://mysql.customer.internal:3306/virbius?sslMode=REQUIRED&serverTimezone=UTC
# sslMode=VERIFY_IDENTITY（推荐，需客户 CA）：改用下行 URL，把 CA 放 ./certs/ca.pem，
# 并解开 node-a-control.yml 里两个服务的 certs 卷注释（见手册 §6）：
# VIRBIUS_JDBC_URL=jdbc:mariadb://mysql.customer.internal:3306/virbius?sslMode=VERIFY_IDENTITY&serverSslCert=/certs/ca.pem&serverTimezone=UTC

KAFKA_BOOTSTRAP_SERVERS=kafka1.customer.internal:9092
KAFKA_SASL_USERNAME=virbius
KAFKA_SASL_PASSWORD=__change_me__
# 客户 Kafka 若是 PLAIN/其他机制，改这里（SCRAM-SHA-256 为默认）
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

REDIS_HOST=redis.customer.internal
REDIS_PORT=6379
REDIS_PASSWORD=__change_me__

# ── Virbius 安全密钥（全部 ≥32 字符；不填 control 会拒绝启动） ──────────────────
VIRBIUS_LICENSE_MASTER_KEY=__change_me_32_chars_minimum________
VIRBIUS_API_KEY_PEPPER=__change_me_32_chars_minimum________
# 代客凭证平面（可选；不启用则留空）
VIRBIUS_DELEGATED_MASTER_KEY=
# 审计导出密钥（base64 32B；不导出审计可留空，导出任务会 fail-closed）
VIRBIUS_AUDIT_EXPORT_KEY=

# ── 运营台登录（virbius-auth） ────────────────────────────────────────────────
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=__change_me__
# 运营台对外地址（浏览器可达；建议 HTTPS，见手册 §6 nginx）
CONTROL_PUBLIC_URL=http://10.0.0.11:8080

# ── 节点地址（按现场实际 IP/域名填） ──────────────────────────────────────────
NODE_A=10.0.0.11   # 管理面: control + auth
NODE_B=10.0.0.12   # 决策面: engine (+ 可选 Ollama)
NODE_C=10.0.0.13   # 接入面: mcp-proxy

# ── 提示词审查模型（二选一，见手册 §4） ───────────────────────────────────────
# 选项A（默认）：引擎机旁 Ollama（compose profile llm-local），模型 GGUF 经
#   hf-mirror/ModelScope 预下载到 B 机 ./models/，由 ollama-init 自动导入。
PROMPT_LLM_BASE_URL=http://ollama:11434
# 选项B：客户 vLLM（OpenAI 兼容端点）。vLLM 不支持 GGUF，用 safetensors 权重
#   （ModelScope 同仓库已提供，下载命令见 README.zh.md §4）。
#   改用方式：注释上面一行，解开下面一行：
# PROMPT_LLM_BASE_URL=http://vllm.customer.internal:8000
VIRBIUS_PROMPT_LLM_MODEL=i1see1you/virbiusguard:v2.0
# 选项A 的 Ollama 镜像名（离线包默认含 ollama/ollama:0.11.10，可改客户私有仓库地址）
OLLAMA_IMAGE=ollama/ollama:0.11.10

# ── 边缘接入 ──────────────────────────────────────────────────────────────────
# MCP 上游（被代理的 MCP Server 地址，SSE；多上游见 PROXY_CONFIG.md）
VIRBIUS_UPSTREAM_URL=http://mcp-server.customer.internal:8080/sse

# ── 镜像（离线 tar 包 docker load 后即为该 tag；见手册 §3） ────────────────────
IMAGE_REGISTRY=hb.grainmind.cn/library
IMAGE_TAG=v1.0.3
